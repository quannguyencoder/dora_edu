# --- Messaging channels ---
DISCORD_BOT_TOKEN="your_discord_bot_token"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# Zalo OA - leave empty until you run dora-run-zalo-bot
ZALO_ACCESS_TOKEN=""
ZALO_OA_SECRET=""
ZALO_WEBHOOK_HOST="0.0.0.0"
ZALO_WEBHOOK_PORT="8080"

# --- LLM generation ---
# "openai" or "gemini" -- picks which key/model below build_generator() uses.
LLM_PROVIDER="openai"

OPENAI_API_KEY="your_openai_api_key"
# Optional: point to any OpenAI-compatible endpoint (local LLM, proxy, ...)
OPENAI_BASE_URL=""

# Get a free-tier key at https://aistudio.google.com/apikey (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=""

# For LLM_PROVIDER=openai use e.g. "gpt-4o-mini"; for "gemini" use e.g. "gemini-3.6-flash"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.3"

# --- Vector store ---
CHROMA_DB_PATH="./vector_db"
CHROMA_COLLECTION_NAME="moet_textbooks"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# --- Retrieval tuning ---
RETRIEVAL_TOP_K="5"
MAX_RETRIEVAL_DISTANCE="1.1"
CHUNK_SIZE="900"
CHUNK_OVERLAP="150"

# --- Session ---
SESSION_MAX_TURNS="6"
LOG_LEVEL="INFO"
