# --- Messaging channels ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# Zalo OA (planned channel - leave empty until the Zalo adapter is enabled)
ZALO_ACCESS_TOKEN=""
ZALO_OA_SECRET=""

# --- LLM generation ---
OPENAI_API_KEY="your_openai_api_key"
# Optional: point to any OpenAI-compatible endpoint (local LLM, proxy, ...)
OPENAI_BASE_URL=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.3"

# --- Vector store ---
CHROMA_DB_PATH="./vector_db"
CHROMA_COLLECTION_NAME="moet_textbooks"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# --- Retrieval tuning ---
RETRIEVAL_TOP_K="5"
MAX_RETRIEVAL_DISTANCE="1.1"
CHUNK_SIZE="900"
CHUNK_OVERLAP="150"

# --- Session ---
SESSION_MAX_TURNS="6"
LOG_LEVEL="INFO"
